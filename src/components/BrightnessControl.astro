<div class="a1-brightness-control" aria-label="页面亮度调节">
  <div class="a1-brightness-control__layer" aria-hidden="true"></div>
  <div class="a1-brightness-control__actions">
    <div class="a1-brightness-control__panel" id="brightness-panel" hidden>
      <div class="a1-brightness-control__title">
        <span>页面亮度</span>
        <output for="brightness-range" data-brightness-value>100%</output>
      </div>
      <div class="a1-brightness-control__range-row">
        <span aria-hidden="true">◐</span>
        <input id="brightness-range" type="range" min="55" max="100" step="1" value="100" aria-label="页面亮度" />
        <span aria-hidden="true">☀</span>
      </div>
    </div>
    <button class="a1-brightness-control__trigger" type="button" aria-expanded="false" aria-controls="brightness-panel" aria-label="调节页面亮度" title="调节页面亮度">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
    </button>
  </div>
</div>

<style is:global>
  :root { --a1-brightness: 100; }

  .a1-brightness-control {
    position: fixed;
    z-index: 200;
    inset: 0;
    pointer-events: none;
  }

  .a1-brightness-control__layer {
    position: absolute;
    inset: 0;
    background: #02060d;
    opacity: 0;
    pointer-events: none;
    transition: opacity .18s ease;
  }

  .a1-brightness-control__actions {
    position: fixed;
    right: 22px;
    bottom: 22px;
    display: grid;
    justify-items: end;
    gap: 10px;
    pointer-events: auto;
  }

  .a1-brightness-control__trigger {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--line-strong) 88%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--surface-strong) 88%, transparent);
    color: var(--primary-deep);
    box-shadow: var(--shadow), inset 0 1px 0 rgba(255, 255, 255, .32);
    backdrop-filter: blur(14px);
    cursor: pointer;
    transition: transform .18s ease, border-color .18s ease, color .18s ease, background .18s ease;
  }

  .a1-brightness-control__trigger:hover,
  .a1-brightness-control__trigger[aria-expanded='true'] {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--primary) 56%, var(--line-strong));
    background: color-mix(in srgb, var(--surface-strong) 96%, transparent);
    color: var(--text);
  }

  .a1-brightness-control__trigger svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .a1-brightness-control__panel {
    width: min(252px, calc(100vw - 44px));
    padding: 13px 14px 14px;
    border: 1px solid color-mix(in srgb, var(--line-strong) 86%, transparent);
    border-radius: 16px;
    background: color-mix(in srgb, var(--surface-strong) 94%, transparent);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(16px);
  }

  .a1-brightness-control__title,
  .a1-brightness-control__range-row {
    display: flex;
    align-items: center;
  }

  .a1-brightness-control__title {
    justify-content: space-between;
    gap: 12px;
    color: var(--text);
    font-size: .84rem;
    font-weight: 800;
  }

  .a1-brightness-control__title output {
    color: var(--primary-deep);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: .76rem;
  }

  .a1-brightness-control__range-row {
    gap: 9px;
    margin-top: 10px;
    color: var(--muted);
    font-size: .9rem;
  }

  .a1-brightness-control__range-row input {
    width: 100%;
    accent-color: var(--primary-deep);
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .a1-brightness-control__actions {
      right: 14px;
      bottom: 14px;
    }
  }
</style>

<script>
  const storageKey = 'a1right-brightness';
  const control = document.querySelector<HTMLElement>('.a1-brightness-control');
  const layer = control?.querySelector<HTMLElement>('.a1-brightness-control__layer');
  const trigger = control?.querySelector<HTMLButtonElement>('.a1-brightness-control__trigger');
  const panel = control?.querySelector<HTMLElement>('.a1-brightness-control__panel');
  const range = control?.querySelector<HTMLInputElement>('#brightness-range');
  const output = control?.querySelector<HTMLOutputElement>('[data-brightness-value]');

  const readBrightness = () => {
    try {
      const saved = Number(window.localStorage.getItem(storageKey));
      return Number.isFinite(saved) && saved >= 55 && saved <= 100 ? saved : 100;
    } catch {
      return 100;
    }
  };

  const applyBrightness = (value: number, persist = true) => {
    const brightness = Math.max(55, Math.min(100, Math.round(value)));
    document.documentElement.style.setProperty('--a1-brightness', String(brightness));
    if (layer) layer.style.opacity = String((100 - brightness) / 100);
    if (range) range.value = String(brightness);
    if (output) output.value = `${brightness}%`;
    if (persist) {
      try { window.localStorage.setItem(storageKey, String(brightness)); } catch {}
    }
  };

  applyBrightness(readBrightness(), false);

  trigger?.addEventListener('click', () => {
    const isOpen = trigger.getAttribute('aria-expanded') === 'true';
    trigger.setAttribute('aria-expanded', String(!isOpen));
    if (panel) panel.hidden = isOpen;
  });

  range?.addEventListener('input', () => applyBrightness(Number(range.value)));
</script>
