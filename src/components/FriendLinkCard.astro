---
import type { Locale } from '../config';
import type { FriendLink } from '../data/friends';

interface Props {
  locale: Locale;
  item: FriendLink;
}

const { locale, item } = Astro.props;
const domain = new URL(item.url).hostname.replace(/^www\./, '');
---

<article class="ff-card friend-card">
  <img class="friend-card__avatar" src={item.avatar} alt={item.owner} loading="lazy" />

  <div class="friend-card__body">
    <div class="friend-card__header">
      <div class="friend-card__meta">
        <h2>{item.name}</h2>
        <p><span>{item.owner}</span><i aria-hidden="true">·</i><span>{domain}</span></p>
      </div>
    </div>

    <p class="friend-card__description">{item.description[locale]}</p>

    <div class="friend-card__tags" aria-label={locale === 'en' ? 'Tags' : '标签'}>
      {item.tags && item.tags.length > 0 && (
        <>
        {item.tags.map((tag) => (
          <span>#{tag}</span>
        ))}
        </>
      )}
    </div>
  </div>

  <div class="friend-card__actions">
    <a class="friend-card__visit" href={item.url} target="_blank" rel="noreferrer" aria-label={`Visit ${item.name}`}>
      <span>{locale === 'en' ? 'Visit' : '访问'}</span><b aria-hidden="true">↗</b>
    </a>
  </div>
</article>
