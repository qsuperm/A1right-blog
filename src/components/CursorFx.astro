<div class="a1-cursor" aria-hidden="true">
  <span class="a1-cursor__dot"></span>
</div>

<style is:global>
  html.a1-cursor-active,
  html.a1-cursor-active body,
  html.a1-cursor-active body * {
    cursor: none !important;
  }

  html.a1-cursor-active :is(input, textarea, [contenteditable='true']) {
    cursor: text !important;
  }

  .a1-cursor {
    position: fixed;
    z-index: 2147483647;
    top: 0;
    left: 0;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(-50%, -50%, 0);
    transition: opacity .14s ease;
    will-change: transform;
  }

  .a1-cursor.is-visible { opacity: 1; }
  .a1-cursor.is-text { opacity: 0; }

  .a1-cursor__dot {
    position: relative;
    width: 8px;
    height: 8px;
    display: block;
    border-radius: 50%;
    background: #e8fbff;
    box-shadow: 0 0 7px rgba(203, 242, 255, .98), 0 0 18px rgba(112, 203, 236, .4);
    transition: width .18s ease, height .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease, transform .18s ease;
  }

  .a1-cursor__dot::before {
    content: '';
    position: absolute;
    inset: -8px;
    border: 1px solid rgba(184, 231, 247, .55);
    border-radius: 50%;
    opacity: .62;
    transform: scale(.72);
    transition: opacity .18s ease, transform .18s ease, border-color .18s ease;
  }

  .a1-cursor.is-interactive .a1-cursor__dot {
    width: 26px;
    height: 26px;
    border: 1px solid rgba(255, 236, 177, .92);
    background: rgba(255, 236, 177, .08);
    box-shadow: 0 0 10px rgba(255, 228, 151, .72), 0 0 24px rgba(255, 190, 102, .26), inset 0 0 9px rgba(255, 237, 181, .18);
  }

  .a1-cursor.is-interactive .a1-cursor__dot::before {
    inset: 4px;
    border-color: rgba(255, 246, 212, .72);
    opacity: 1;
    transform: scale(1) rotate(45deg);
  }

  .a1-cursor.is-pressed .a1-cursor__dot {
    transform: scale(.72);
  }

  :root[data-theme='light'] .a1-cursor__dot {
    background: #238de9;
    box-shadow: 0 0 7px rgba(37, 149, 239, .78), 0 0 18px rgba(75, 174, 255, .28);
  }

  :root[data-theme='light'] .a1-cursor__dot::before {
    border-color: rgba(47, 148, 239, .62);
  }

  :root[data-theme='light'] .a1-cursor.is-interactive .a1-cursor__dot {
    border-color: rgba(32, 132, 223, .9);
    background: rgba(68, 163, 243, .09);
    box-shadow: 0 0 10px rgba(41, 143, 233, .6), 0 0 24px rgba(80, 168, 247, .22), inset 0 0 9px rgba(203, 237, 255, .52);
  }

  @media (pointer: coarse), (prefers-reduced-motion: reduce) {
    .a1-cursor { display: none; }
  }
</style>

<script>
  const initCursor = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(pointer: coarse)').matches) return;

    const cursor = document.querySelector<HTMLElement>('.a1-cursor');
    if (!cursor) return;

    let frame = 0;
    let x = -100;
    let y = -100;

    const render = () => {
      frame = 0;
      cursor.style.setProperty('transform', `translate3d(calc(${x}px - 50%), calc(${y}px - 50%), 0)`);
    };

    const updateState = (target: EventTarget | null) => {
      const element = target instanceof Element ? target : null;
      const isText = Boolean(element?.closest("input:not([type='button']):not([type='submit']):not([type='reset']), textarea, [contenteditable='true']"));
      const isInteractive = Boolean(element?.closest('a, button, [role="button"], summary, select, label, input:not([type="text"]):not([type="search"]):not([type="email"]):not([type="password"]), [data-cursor-interactive]'));
      cursor.classList.toggle('is-text', isText);
      cursor.classList.toggle('is-interactive', !isText && isInteractive);
    };

    const onMove = (event: PointerEvent) => {
      x = event.clientX;
      y = event.clientY;
      cursor.classList.add('is-visible');
      updateState(event.target);
      if (!frame) frame = window.requestAnimationFrame(render);
    };
    const onDown = () => cursor.classList.add('is-pressed');
    const onUp = () => cursor.classList.remove('is-pressed');
    const onLeave = () => cursor.classList.remove('is-visible');
    const onEnter = () => cursor.classList.add('is-visible');

    document.documentElement.classList.add('a1-cursor-active');
    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('pointerdown', onDown, { passive: true });
    window.addEventListener('pointerup', onUp, { passive: true });
    document.documentElement.addEventListener('pointerleave', onLeave);
    document.documentElement.addEventListener('pointerenter', onEnter);

    window.addEventListener('pagehide', () => {
      if (frame) window.cancelAnimationFrame(frame);
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerdown', onDown);
      window.removeEventListener('pointerup', onUp);
      document.documentElement.removeEventListener('pointerleave', onLeave);
      document.documentElement.removeEventListener('pointerenter', onEnter);
      document.documentElement.classList.remove('a1-cursor-active');
    }, { once: true });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCursor, { once: true });
  } else {
    initCursor();
  }
</script>
