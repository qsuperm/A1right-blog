<script>
  import { BAClickFX } from 'ba-click-fx';

  type CursorFxHandle = BAClickFX | null;

  const globalWindow = window as Window & {
    __A1RIGHT_BA_CURSOR__?: CursorFxHandle;
  };

  const getThemePreset = (theme: string) => {
    if (theme === 'light') {
      return {
        color: [76, 157, 255] as [number, number, number],
        opacity: 0.8,
        trailWhiteMix: 0.48,
        ringWhiteMix: 0.7,
        ringColorEndWhiteMix: 0.86,
        trailGlowAlpha: 0.28,
        trailSoftGlowAlpha: 0.13,
        ringGlowAlpha: 0.29,
        ringSoftGlowAlpha: 0.17,
      };
    }

    return {
      color: [225, 237, 255] as [number, number, number],
      opacity: 0.78,
      trailWhiteMix: 0.96,
      ringWhiteMix: 1,
      ringColorEndWhiteMix: 1,
      trailGlowAlpha: 0.25,
      trailSoftGlowAlpha: 0.12,
      ringGlowAlpha: 0.27,
      ringSoftGlowAlpha: 0.16,
    };
  };

  const applyThemePreset = (fx: BAClickFX, theme: string) => {
    const preset = getThemePreset(theme);
    fx.setColor(...preset.color);
    fx.setOpacity(preset.opacity);
    fx.setTrailWhiteMix(preset.trailWhiteMix);
    fx.setRingWhiteMix(preset.ringWhiteMix);
    fx.setRingColorEndWhiteMix(preset.ringColorEndWhiteMix);
    fx.setTrailGlowAlpha(preset.trailGlowAlpha);
    fx.setTrailSoftGlowAlpha(preset.trailSoftGlowAlpha);
    fx.setRingGlowAlpha(preset.ringGlowAlpha);
    fx.setRingSoftGlowAlpha(preset.ringSoftGlowAlpha);
  };

  const createCursorFx = () => {
    const fx = new BAClickFX({
      color: [224, 232, 244],
      scale: 1.18,
      opacity: 0.78,
      trailEnabled: true,
      trailAlways: true,
      clickEnabled: true,
      touchAction: 'auto',
    });

    fx.setGlow(true);
    fx.setFakeGlow(true);
    fx.setClickFakeGlow(true);
    fx.setSpeed(0.82, 0.9);
    fx.setDpr(2);

    // Click: layered halo, rotating arcs and a denser shard burst.
    fx.setClickTotalLife(38);
    fx.setClickScaleMul(1.46);
    fx.setClickHaloRadius(132);
    fx.setClickShardFlicker(6, 0.38);
    fx.setSparksCount(10);
    fx.setDiskSize(31);
    fx.setDiskGlow(5.6, 0.23);
    fx.setDiskTiming(16, 0.78, 0.28, 0.72);
    fx.setRingRotationSpeed(0.018);
    fx.setRingEmission(0.68);
    fx.setRingWidth(1.15, 5.5);
    fx.setRingAlpha(0.96);
    fx.setRingDelay(1);
    fx.setRingMaxLife(38);
    fx.setRingPostDiskGrow(34);
    fx.setRingGlowRadiusAdd(74);
    fx.setRingSoftGlowRadiusAdd(126);
    fx.setRingArcLength(5.3, 1.3);
    fx.setRingSegmentCount(3, 5);
    fx.setRingSegmentDetail(0.42, 0.52, 0.5, 1.55);
    fx.setRingRotationJitter(0.8, 2.1);
    fx.setRingRadiusJitter(0.35, 1.15);

    // Trail: a wider luminous ribbon with scattered, flickering particles.
    fx.setTrailBrightness(1);
    fx.setTrailWidth(3.7, 2.05);
    fx.setTrailLength(1250, 5200);
    fx.setTrailLife(30, 48);
    fx.setTrailSmooth(0.42);
    fx.setTrailGradientChunk(1.05);
    fx.setTrailCoreWidth(0.52, 0.86);
    fx.setTrailHotWidth(0.22, 0.38);
    fx.setTrailRibbon(2.5, 0.13);
    fx.setTrailGlowRadius(28);
    fx.setTrailGlowIntensity(0.24);
    fx.setTrailGlowWidthMul(2.35);
    fx.setTrailSoftGlowWidthMul(4.6);
    fx.setTrailRailWidth(0.28, 0.46);
    fx.setTrailLayerAlpha(1, 0.86, 0.58, 0.3, 0.14, 0.07);
    fx.setMaxShards(92);
    fx.setShardSpacing(76);
    fx.setShardChance(0.1, 0.34);
    fx.setShardLargeChance(0.68);
    fx.setMoveSparkChance(0.012);
    fx.setTrailShardFlicker(6, 0.38, 0.28);
    fx.setTrailShardOffset(3, 48);
    return fx;
  };

  const syncCursorFxTheme = () => {
    const fx = globalWindow.__A1RIGHT_BA_CURSOR__;
    if (!fx) return;
    const theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    applyThemePreset(fx, theme);
  };

  const initCursorFx = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(pointer: coarse)').matches) return;

    globalWindow.__A1RIGHT_BA_CURSOR__?.destroy?.();

    const fx = createCursorFx();
    globalWindow.__A1RIGHT_BA_CURSOR__ = fx;
    syncCursorFxTheme();

    const observer = new MutationObserver(() => {
      syncCursorFxTheme();
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    window.addEventListener(
      'pagehide',
      () => {
        observer.disconnect();
        globalWindow.__A1RIGHT_BA_CURSOR__?.destroy?.();
        globalWindow.__A1RIGHT_BA_CURSOR__ = null;
      },
      { once: true },
    );
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCursorFx, { once: true });
  } else {
    initCursorFx();
  }
</script>
