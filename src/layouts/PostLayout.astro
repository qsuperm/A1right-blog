---
import BaseLayout from './BaseLayout.astro';
import ArticleComments from '../components/ArticleComments.astro';
import PageViewBadge from '../components/PageViewBadge.astro';
import { SITE, type Locale } from '../config';
import {
  formatDate,
  getArticleUrl,
  getArticleWordCountFromText,
  getCategoryUrl,
  getLocaleHome,
  getTagUrl,
  type ArticleEntry,
} from '../utils/articles';
import { buildBreadcrumbJsonLd, getSchemaLanguage, toAbsoluteUrl } from '../utils/seo';

interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: ArticleEntry;
  locale: Locale;
  headings: HeadingItem[];
  Content: any;
  readingMinutes: number;
  previous?: ArticleEntry;
  next?: ArticleEntry;
}

const { entry, locale, headings, Content, readingMinutes, previous, next } = Astro.props;
const homeHref = getLocaleHome(locale);
const backHref = `${homeHref}#posts`;
const postsHref = locale === 'en' ? '/en/posts' : '/posts';
const toc = headings.filter((heading) => heading.depth >= 1 && heading.depth <= 3);
type TocHeading = (typeof toc)[number];
type TocNode = { heading: TocHeading; number: number; children: TocNode[] };
const tocTree = (() => {
  const roots: TocNode[] = [];
  const stack: TocNode[] = [];
  toc.forEach((heading, index) => {
    const node: TocNode = { heading, number: index + 1, children: [] };
    while (stack.length > 0 && stack[stack.length - 1].heading.depth >= heading.depth) stack.pop();
    if (stack.length > 0) stack[stack.length - 1].children.push(node);
    else roots.push(node);
    stack.push(node);
  });
  return roots;
})();
const seoTitle = entry.data.seoTitle ?? entry.data.title;
const seoDescription = entry.data.seoDescription ?? entry.data.excerpt;
const authorName = entry.data.author ?? SITE.author;
const articleUrl = getArticleUrl(entry);
const wordCount = getArticleWordCountFromText(entry.body ?? '');
const publishedLabel = locale === 'en' ? 'Published' : '发布';
const updatedLabel = locale === 'en' ? 'Updated' : '更新';
const readingLabel = locale === 'en' ? `${readingMinutes} min read` : `${readingMinutes} 分钟阅读`;
const wordCountLabel = locale === 'en' ? `${wordCount.toLocaleString()} words` : `字数 ${wordCount.toLocaleString()}`;
const tocLabel = locale === 'en' ? 'On this page' : '本页目录';
const tocEyebrow = locale === 'en' ? 'Reading map' : '阅读导航';
const metaLabel = locale === 'en' ? 'Article meta' : '文章信息';
const previousLabel = locale === 'en' ? 'Previous post' : '上一篇';
const nextLabel = locale === 'en' ? 'Next post' : '下一篇';
const backLabel = locale === 'en' ? 'Back to homepage feed' : '返回首页文章流';
const authorLabel = locale === 'en' ? 'Author' : '作者';

const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: seoTitle,
  description: seoDescription,
  image: [toAbsoluteUrl(entry.data.cover)],
  datePublished: entry.data.publishedAt.toISOString(),
  ...(entry.data.updatedAt ? { dateModified: entry.data.updatedAt.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: authorName,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.author,
  },
  mainEntityOfPage: toAbsoluteUrl(articleUrl),
  url: toAbsoluteUrl(articleUrl),
  articleSection: entry.data.category,
  keywords: entry.data.tags.join(', '),
  inLanguage: getSchemaLanguage(locale),
};

const breadcrumbStructuredData = buildBreadcrumbJsonLd([
  { label: locale === 'en' ? 'Home' : '首页', href: homeHref },
  { label: locale === 'en' ? 'Posts' : '文章流', href: postsHref },
  { label: entry.data.category, href: getCategoryUrl(locale, entry.data.categoryKey) },
  { label: entry.data.title, href: articleUrl },
]);
---

<BaseLayout
  locale={locale}
  title={seoTitle}
  description={seoDescription}
  socialImage={entry.data.cover}
  type="article"
  keywords={entry.data.tags}
  structuredData={[articleStructuredData, breadcrumbStructuredData]}
>
  <section class="article-shell glass-wall">
    <a class="article-back" href={backHref}>← {backLabel}</a>

    <article class="ff-card article-hero">
      <div class="article-hero__content">
        <div class="article-hero__meta">
          <a class="article-hero__chip" href={getCategoryUrl(locale, entry.data.categoryKey)}>{entry.data.category}</a>
          <time datetime={entry.data.publishedAt.toISOString()}>{publishedLabel}: {formatDate(entry.data.publishedAt, locale)}</time>
          <span>{readingLabel}</span>
          <span>{wordCountLabel}</span>
          <PageViewBadge path={articleUrl} locale={locale} />
          <span>{authorLabel}: {authorName}</span>
          {entry.data.updatedAt && (
            <time datetime={entry.data.updatedAt.toISOString()}>{updatedLabel}: {formatDate(entry.data.updatedAt, locale)}</time>
          )}
        </div>

        <h1>{entry.data.title}</h1>
        <p class="article-hero__excerpt">{entry.data.excerpt}</p>

        <div class="article-hero__tags">
          {entry.data.tags.map((tag) => (
            <a href={getTagUrl(locale, tag)}>#{tag}</a>
          ))}
        </div>
      </div>

      <div class="article-cover">
        <img src={entry.data.cover} alt={entry.data.coverAlt || entry.data.title} loading="eager" />
      </div>
    </article>

    <div class="article-layout">
      <article class="ff-card article-content-card">
        <div class="article-content">
          <Content />
        </div>

        <div class="article-nav">
          {previous ? (
            <a class="ff-card article-nav__card" href={getArticleUrl(previous)}>
              <small>{previousLabel}</small>
              <strong>{previous.data.title}</strong>
            </a>
          ) : (
            <div class="ff-card article-nav__card article-nav__card--empty"></div>
          )}

          {next ? (
            <a class="ff-card article-nav__card" href={getArticleUrl(next)}>
              <small>{nextLabel}</small>
              <strong>{next.data.title}</strong>
            </a>
          ) : (
            <div class="ff-card article-nav__card article-nav__card--empty"></div>
          )}
        </div>

        <ArticleComments locale={locale} />
      </article>

      <aside class="article-aside">
        {toc.length > 0 && (
          <section class="ff-card article-panel article-panel--toc" data-article-toc>
            <div class="article-toc__header">
              <div>
                <p>{tocEyebrow}</p>
                <h2>{tocLabel}</h2>
              </div>
              <span class="article-toc__count" aria-label={locale === 'en' ? `${toc.length} sections` : `${toc.length} 个章节`}>{String(toc.length).padStart(2, '0')}</span>
            </div>
            <div class="article-toc__viewport">
              <ul class="article-toc">
                {tocTree.map((node) => (
                  <li class="article-toc__item article-toc__item--depth-1" data-toc-node>
                    <div class="article-toc__row">
                      {node.children.length > 0 ? (
                        <button
                          class="article-toc__toggle"
                          type="button"
                          data-toc-toggle
                          aria-expanded="true"
                          aria-label={locale === 'en' ? `Collapse ${node.heading.text}` : `收起「${node.heading.text}」`}
                        >
                          <span class="article-toc__chevron" aria-hidden="true">
                            <svg viewBox="0 0 12 12" focusable="false"><path d="M2 4.5 6 8.5 10 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                          </span>
                        </button>
                      ) : (
                        <span class="article-toc__toggle article-toc__toggle--placeholder" aria-hidden="true"></span>
                      )}
                      <a data-toc-link href={`#${node.heading.slug}`}>
                        <span class="article-toc__number" aria-hidden="true">{String(node.number).padStart(2, '0')}</span>
                        <span class="article-toc__text">{node.heading.text}</span>
                      </a>
                    </div>
                    {node.children.length > 0 && (
                      <ul class="article-toc__children">
                        {node.children.map((child) => (
                          <li class={`article-toc__item article-toc__item--depth-${child.heading.depth}`} data-toc-node>
                            <div class="article-toc__row">
                              {child.children.length > 0 ? (
                                <button
                                  class="article-toc__toggle"
                                  type="button"
                                  data-toc-toggle
                                  aria-expanded="true"
                                  aria-label={locale === 'en' ? `Collapse ${child.heading.text}` : `收起「${child.heading.text}」`}
                                >
                                  <span class="article-toc__chevron" aria-hidden="true">
                            <svg viewBox="0 0 12 12" focusable="false"><path d="M2 4.5 6 8.5 10 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                          </span>
                                </button>
                              ) : (
                                <span class="article-toc__toggle article-toc__toggle--placeholder" aria-hidden="true"></span>
                              )}
                              <a data-toc-link href={`#${child.heading.slug}`}>
                                <span class="article-toc__number" aria-hidden="true">{String(child.number).padStart(2, '0')}</span>
                                <span class="article-toc__text">{child.heading.text}</span>
                              </a>
                            </div>
                            {child.children.length > 0 && (
                              <ul class="article-toc__children">
                                {child.children.map((leaf) => (
                                  <li class={`article-toc__item article-toc__item--depth-${leaf.heading.depth}`} data-toc-node>
                                    <div class="article-toc__row">
                                      <span class="article-toc__toggle article-toc__toggle--placeholder" aria-hidden="true"></span>
                                      <a data-toc-link href={`#${leaf.heading.slug}`}>
                                        <span class="article-toc__number" aria-hidden="true">{String(leaf.number).padStart(2, '0')}</span>
                                        <span class="article-toc__text">{leaf.heading.text}</span>
                                      </a>
                                    </div>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        <section class="ff-card article-panel">
          <h2>{metaLabel}</h2>
          <dl class="article-meta-list">
            <div>
              <dt>{authorLabel}</dt>
              <dd>{authorName}</dd>
            </div>
            <div>
              <dt>{publishedLabel}</dt>
              <dd>{formatDate(entry.data.publishedAt, locale)}</dd>
            </div>
            {entry.data.updatedAt && (
              <div>
                <dt>{updatedLabel}</dt>
                <dd>{formatDate(entry.data.updatedAt, locale)}</dd>
              </div>
            )}
            <div>
              <dt>{locale === 'en' ? 'Category' : '栏目'}</dt>
              <dd>{entry.data.category}</dd>
            </div>
            <div>
              <dt>{locale === 'en' ? 'Views' : '浏览量'}</dt>
              <dd><PageViewBadge path={articleUrl} locale={locale} mode="full" /></dd>
            </div>
            <div>
              <dt>{locale === 'en' ? 'Word count' : '字数'}</dt>
              <dd>{wordCount.toLocaleString()}</dd>
            </div>
            <div>
              <dt>{locale === 'en' ? 'Tags' : '标签'}</dt>
              <dd>{entry.data.tags.join(' / ')}</dd>
            </div>
          </dl>
        </section>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  const tocRoot = document.querySelector<HTMLElement>('[data-article-toc]');
  const tocLinks = Array.from(tocRoot?.querySelectorAll<HTMLAnchorElement>('[data-toc-link]') ?? []);
  const tocViewport = tocRoot?.querySelector<HTMLElement>('.article-toc__viewport');

  // 折叠：按钮控制同一 li 下的子列表
  tocRoot?.querySelectorAll<HTMLButtonElement>('[data-toc-toggle]').forEach((button) => {
    const item = button.closest<HTMLElement>('[data-toc-node]');
    const children = item?.querySelector<HTMLElement>(':scope > .article-toc__children');
    if (!children) return;
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') !== 'false';
      button.setAttribute('aria-expanded', String(!expanded));
      children.hidden = expanded;
    });
  });

  const expandAncestors = (link: HTMLAnchorElement) => {
    let node = link.closest<HTMLElement>('[data-toc-node]')?.parentElement;
    while (node) {
      const parentItem = node.closest<HTMLElement>('[data-toc-node]');
      if (!parentItem) break;
      const toggle = parentItem.querySelector<HTMLButtonElement>(':scope > .article-toc__row > [data-toc-toggle]');
      const children = parentItem.querySelector<HTMLElement>(':scope > .article-toc__children');
      if (toggle && children && children.hidden) {
        children.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
      }
      node = parentItem.parentElement?.closest<HTMLElement>('[data-toc-node]');
    }
  };

  if (tocLinks.length > 0 && 'IntersectionObserver' in window) {
    const linksById = new Map(tocLinks.map((link) => [decodeURIComponent(link.hash.slice(1)), link]));
    const visibleHeadings = new Map<string, number>();
    let activeId = '';

    const activate = (id: string) => {
      if (!id || id === activeId) return;
      activeId = id;
      const activeLink = linksById.get(id);
      tocLinks.forEach((link) => link.classList.toggle('is-active', link === activeLink));
      if (activeLink) expandAncestors(activeLink);

      if (activeLink && tocViewport) {
        window.requestAnimationFrame(() => {
          const nextTop = activeLink.offsetTop - (tocViewport.clientHeight - activeLink.offsetHeight) * 0.42;
          tocViewport.scrollTo({ top: Math.max(0, nextTop), behavior: 'smooth' });
        });
      }
    };

    const updateActive = () => {
      const [id] = [...visibleHeadings.entries()].sort(([, topA], [, topB]) => topA - topB)[0] ?? [];
      if (id) activate(id);
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const id = (entry.target as HTMLElement).id;
        if (!id) return;
        if (entry.isIntersecting) visibleHeadings.set(id, entry.boundingClientRect.top);
        else visibleHeadings.delete(id);
      });
      updateActive();
    }, { rootMargin: '-15% 0px -68% 0px', threshold: 0 });

    linksById.forEach((link, id) => {
      const heading = document.getElementById(id);
      if (heading) observer.observe(heading);
      link.addEventListener('click', () => activate(id));
    });

    const initialId = decodeURIComponent(window.location.hash.slice(1));
    if (initialId && linksById.has(initialId)) activate(initialId);
    else activate(linksById.keys().next().value ?? '');

    window.addEventListener('pagehide', () => observer.disconnect(), { once: true });
  }
</script>
